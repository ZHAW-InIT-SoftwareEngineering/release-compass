# Q5: measurements of the same source, metric and statistic in two runs of a
# gate type. The delta is computed here, only when both values exist and the
# units match.
# Bindings: ?id, ?baseline_id (report IDs), ?gate_type, ?metric, ?statistic.
# Each side is a subquery, so RDFLib joins two small results by source
# instead of matching every pair of measurements.
SELECT ?source ?unit ?baseline_unit ?current ?baseline ?delta
WHERE {
    {
        SELECT ?source ?unit ?current
        WHERE {
            ?report ai2core:has_id ?id ;
                    release-compass:contains_gate ?gate .
            ?gate release-compass:gate_type ?gate_type ;
                  release-compass:produces_metric ?measurement .
            ?measurement release-compass:metric_name ?metric ;
                         release-compass:statistic ?statistic ;
                         release-compass:measured_from/release-compass:source_name
                         ?source .
            OPTIONAL { ?measurement release-compass:value ?current }
            OPTIONAL { ?measurement release-compass:unit ?unit }
        }
    }
    {
        SELECT ?source ?baseline_unit ?baseline
        WHERE {
            ?baseline_report ai2core:has_id ?baseline_id ;
                             release-compass:contains_gate ?baseline_gate .
            ?baseline_gate release-compass:gate_type ?gate_type ;
                           release-compass:produces_metric ?baseline_measurement .
            ?baseline_measurement release-compass:metric_name ?metric ;
                                  release-compass:statistic ?statistic ;
                                  release-compass:measured_from/release-compass:source_name
                                  ?source .
            OPTIONAL { ?baseline_measurement release-compass:value ?baseline }
            OPTIONAL { ?baseline_measurement release-compass:unit ?baseline_unit }
        }
    }
    # An unbound value or unit makes the expression an error: no delta.
    BIND (IF(?unit = ?baseline_unit, ?current - ?baseline, ?no_delta) AS ?delta)
}
ORDER BY ?source
