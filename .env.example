# Copy to .env and fill in: cp .env.example .env
# Only keys from .env are read; shell variables are ignored.

# Used by configs/llm/openrouter.yaml (api_key_env)
OPENROUTER_API_KEY="sk-or-..."

# Used by configs/cicd/github_dispatch.yaml (token_env): fine-grained PAT for the
# target repository with "Contents: Read and write" permission.
GITHUB_DISPATCH_TOKEN="github_pat_..."
