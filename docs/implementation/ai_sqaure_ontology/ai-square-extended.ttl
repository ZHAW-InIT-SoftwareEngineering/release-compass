                                                       rdfs:label "metric.performance.tb.ui"@en .


###  https://ai-square.ch/ai2apm#metric.performance.tb.ui.blocking_time
<https://ai-square.ch/ai2apm#metric.performance.tb.ui.blocking_time> rdf:type owl:Class ;
