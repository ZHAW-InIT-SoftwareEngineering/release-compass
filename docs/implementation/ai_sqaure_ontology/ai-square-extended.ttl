                                                                                   rdfs:label "metric.performance.tb.ui.first_contentful_paint_time"@en .


###  https://ai-square.ch/ai2apm#metric.performance.tb.ui.largest_contentful_paint_time
<https://ai-square.ch/ai2apm#metric.performance.tb.ui.largest_contentful_paint_time> rdf:type owl:Class ;
                                                                                     rdfs:subClassOf <https://ai-square.ch/ai2apm#metric.performance.tb.ui> ;
