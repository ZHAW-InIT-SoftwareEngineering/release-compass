@prefix : <https://ai-square.ch/ai2core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ai2core: <https://ai-square.ch/ai2core#> .
@base <https://ai-square.ch/ai2core#> .

<https://ai-square.ch/ai2core> rdf:type owl:Ontology ;
                                owl:versionInfo "v2" .

#################################################################
#    Object Properties
#################################################################


###  https://ai-square.ch/ai2core#affects
ai2core:affects rdf:type owl:ObjectProperty ;
                rdfs:domain ai2core:Anomaly ;
                rdfs:range ai2core:Observable ,
                           ai2core:Source .


###  https://ai-square.ch/ai2core#calls
ai2core:calls rdf:type owl:ObjectProperty ;
              rdfs:domain ai2core:Source ;
              rdfs:range ai2core:Source .


###  https://ai-square.ch/ai2core#causes
ai2core:causes rdf:type owl:ObjectProperty .


###  https://ai-square.ch/ai2core#depend_on
ai2core:depend_on rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:Source ;
                  rdfs:range ai2core:Source .


###  https://ai-square.ch/ai2core#detected_by
ai2core:detected_by rdf:type owl:ObjectProperty ;
                    rdfs:domain ai2core:Anomaly ;
                    rdfs:range ai2core:Model .


###  https://ai-square.ch/ai2core#evaluated_by
ai2core:evaluated_by rdf:type owl:ObjectProperty .


###  https://ai-square.ch/ai2core#evaluates
ai2core:evaluates rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:QualityGate ;
                  rdfs:range ai2core:QualityGateExecution .


###  https://ai-square.ch/ai2core#precedes
ai2core:precedes rdf:type owl:ObjectProperty ;
                 rdfs:domain ai2core:QualityGate ;
                 rdfs:range ai2core:QualityGate .


###  https://ai-square.ch/ai2core#produce
ai2core:produce rdf:type owl:ObjectProperty ;
                rdfs:domain ai2core:QualityGateExecution ;
                rdfs:range ai2core:Observable .

###  https://ai-square.ch/ai2core#produces
ai2core:produces rdf:type owl:ObjectProperty ;
                rdfs:domain ai2core:QualityGateExecution ;
                rdfs:range ai2core:Observable .


###  https://ai-square.ch/ai2core#produces_metric
ai2core:produces_metric rdf:type owl:ObjectProperty ;
                rdfs:domain ai2core:QualityGateExecution ;
                rdfs:range ai2core:Metric .


###  https://ai-square.ch/ai2core#produces_log
ai2core:produces_log rdf:type owl:ObjectProperty ;
                rdfs:domain ai2core:QualityGateExecution ;
                rdfs:range ai2core:Log .


###  https://ai-square.ch/ai2core#produces_test_case
ai2core:produces_test_case rdf:type owl:ObjectProperty ;
                rdfs:domain ai2core:QualityGateExecution ;
                rdfs:range ai2core:TestCase .

###  https://ai-square.ch/ai2core#produces_anomaly
ai2core:produces_anomaly rdf:type owl:ObjectProperty ;
                rdfs:domain ai2core:QualityGateExecution ;
                rdfs:range ai2core:Anomaly .

###  https://ai-square.ch/ai2core#stages_to
ai2core:stages_to rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:Environment ;
                  rdfs:range ai2core:Environment .


###  https://ai-square.ch/ai2core#yield_from
ai2core:yield_from rdf:type owl:ObjectProperty ;
                   rdfs:domain ai2core:Observable ;
                   rdfs:range ai2core:Source .


### https://ai-square.ch/ai2core#evaluated_by
ai2core:evaluated_by rdf:type owl:ObjectProperty ;
                    rdfs:domain ai2core:QualityGate ;
                    rdfs:range ai2core:Requirement .


### https://ai-square.ch/ai2core#contains_target
ai2core:contains_target rdf:type owl:ObjectProperty ;
                    rdfs:domain ai2core:Requirement ;
                    rdfs:range ai2core:Target .


### https://ai-square.ch/ai2core#evaluates
ai2core:evaluates rdf:type owl:ObjectProperty ;
                    rdfs:domain ai2core:TestCase ;
                    rdfs:range ai2core:Requirement .



###  https://ai-square.ch/ai2core#linked_requirement
ai2core:linked_requirement rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:Requirement ;
                  rdfs:range ai2core:Requirement .

###  https://ai-square.ch/ai2core#verifying_test_case
ai2core:verifying_test_case rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:Requirement ;
                  rdfs:range ai2core:TestCase .

###  https://ai-square.ch/ai2core#has_capability
ai2core:has_capability rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:Requirement ;
                  rdfs:range ai2core:Capability .

###  https://ai-square.ch/ai2core#has_coverage
ai2core:has_coverage rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:Capability ;
                  rdfs:range ai2core:CapabilityCoverage .

###  https://ai-square.ch/ai2core#tests
ai2core:tests rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:CapabilityCoverage ;
                  rdfs:range ai2core:TestCase .

###  https://ai-square.ch/ai2core#includes
ai2core:includes rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:TestCase ;
                  rdfs:range ai2core:Action .

###  https://ai-square.ch/ai2core#extracted_by
ai2core:extracted_by rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:Capability ;
                  rdfs:range ai2core:Model .

###  https://ai-square.ch/ai2core#specifies
ai2core:specifies rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:RequirementSpecification ;
                  rdfs:range ai2core:Requirement .


###  https://ai-square.ch/ai2core#specifies
ai2core:specifies rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:TestCaseSpecification ;
                  rdfs:range ai2core:TestCase .


###  https://ai-square.ch/ai2core#specifies
ai2core:specifies rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:SourceSpecification ;
                  rdfs:range ai2core:Source .


###  https://ai-square.ch/ai2core#specifies_requirement
ai2core:specifies_requirement rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:RequirementSpecification ;
                  rdfs:range ai2core:Requirement .

###  https://ai-square.ch/ai2core#specifies_test_case
ai2core:specifies_test_case rdf:type owl:ObjectProperty ;
                  rdfs:domain ai2core:TestCaseSpecification ;
                  rdfs:range ai2core:TestCase .

### https://ai-square.ch/ai2core#evaluated_by_requirement
ai2core:evaluated_by_requirement rdf:type owl:ObjectProperty ;
                    rdfs:domain ai2core:QualityGate ;
                    rdfs:range ai2core:Requirement .

### https://ai-square.ch/ai2core#evaluates_requirement
ai2core:evaluates_requirement rdf:type owl:ObjectProperty ;
                    rdfs:domain ai2core:TestCase ;
                    rdfs:range ai2core:Requirement .


###  https://ai-square.ch/ai2core#affects_source
ai2core:affects_source rdf:type owl:ObjectProperty ;
                rdfs:domain ai2core:Anomaly ;
                rdfs:range ai2core:Observable ,
                           ai2core:Source .


###  https://ai-square.ch/ai2core#produce_reqspec
ai2core:produce_reqspec rdf:type owl:ObjectProperty ;
                rdfs:domain ai2core:QualityGateExecution ;
                rdfs:range ai2core:RequirementSpecification .

#################################################################
#    Data properties
#################################################################

###  https://ai-square.ch/ai2core#aggregation
ai2core:aggregation rdf:type owl:DatatypeProperty ;
                    rdfs:domain ai2core:Target ;
                    rdfs:range xsd:string .


###  https://ai-square.ch/ai2core#end_time
ai2core:end_time rdf:type owl:DatatypeProperty ;
                 rdfs:domain ai2core:Anomaly ,
                             ai2core:Descriptive ;
                 rdfs:range xsd:dateTimeStamp .


###  https://ai-square.ch/ai2core#has_id
ai2core:has_id rdf:type owl:DatatypeProperty ;
               rdfs:domain owl:Thing ;
               rdfs:range xsd:string .


###  https://ai-square.ch/ai2core#severity
ai2core:severity rdf:type owl:DatatypeProperty ;
                 rdfs:domain ai2core:Anomaly ;
                 rdfs:range xsd:string .


###  https://ai-square.ch/ai2core#start_time
ai2core:start_time rdf:type owl:DatatypeProperty ;
                   rdfs:domain ai2core:Anomaly ,
                               ai2core:Descriptive ;
                   rdfs:range xsd:dateTimeStamp .


###  https://ai-square.ch/ai2core#status
ai2core:status rdf:type owl:DatatypeProperty ;
               rdfs:domain ai2core:Log ;
               rdfs:range xsd:string .


###  https://ai-square.ch/ai2core#units
ai2core:units rdf:type owl:DatatypeProperty ;
              rdfs:domain ai2core:Metric ,
                          ai2core:Target ;
              rdfs:range xsd:string .


###  https://ai-square.ch/ai2core#created_on
ai2core:created_on rdf:type owl:DatatypeProperty ;
                   rdfs:domain ai2core:Requirement ;
                   rdfs:range xsd:integer .

###  https://ai-square.ch/ai2core#last_modified_on
ai2core:last_modified_on rdf:type owl:DatatypeProperty ;
                         rdfs:domain ai2core:Requirement ;
                         rdfs:range xsd:integer .


###  https://ai-square.ch/ai2core#criticality
ai2core:criticality rdf:type owl:DatatypeProperty ;
                    rdfs:domain ai2core:Requirement ;
                    rdfs:range xsd:string .


###  https://ai-square.ch/ai2core#remote_url
ai2core:remote_url rdf:type owl:DatatypeProperty ;
                   rdfs:domain ai2core:Requirement ,
                               ai2core:Action ;
                   rdfs:range xsd:anyURI .


###  https://ai-square.ch/ai2core#description
ai2core:description rdf:type owl:DatatypeProperty ;
                    rdfs:domain ai2core:Capability ;
                    rdfs:range xsd:string .


###  https://ai-square.ch/ai2core#confidence
ai2core:confidence rdf:type owl:DatatypeProperty ;
                   rdfs:domain ai2core:Capability ,
                               ai2core:CapabilityCoverage ;
                   rdfs:range xsd:string .


###  https://ai-square.ch/ai2core#coverage
ai2core:coverage rdf:type owl:DatatypeProperty ;
                 rdfs:domain ai2core:Capability ;
                 rdfs:range xsd:boolean .


###  https://ai-square.ch/ai2core#covers_step
# The identifier of an action the coverage was evidenced by, kept as a literal so a
# coverage link still names exactly one test case. It is the has_id of the action node
# the test case mapping writes, which is what a query joins on.
ai2core:covers_step rdf:type owl:DatatypeProperty ;
                    rdfs:domain ai2core:CapabilityCoverage ;
                    rdfs:range xsd:string .


###  https://ai-square.ch/ai2core#reason
ai2core:reason rdf:type owl:DatatypeProperty ;
               rdfs:domain ai2core:CapabilityCoverage ,
                           ai2core:Capability ;
               rdfs:range xsd:string .


###  https://ai-square.ch/ai2core#extracted_on
ai2core:extracted_on rdf:type owl:DatatypeProperty ;
                     rdfs:domain ai2core:Capability ;
                     rdfs:range xsd:long ;
                     rdfs:comment "When the language model extracted the capability, in ms since epoch." .


###  https://ai-square.ch/ai2core#version
ai2core:version rdf:type owl:DatatypeProperty ;
                rdfs:domain ai2core:Model ;
                rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################


###  https://ai-square.ch/ai2core#Anomaly
ai2core:Anomaly rdf:type owl:Class ;
                rdfs:subClassOf ai2core:Observable ;
                rdfs:comment "A deviation from expected behaviour or a violation of a defined requirement, detected within an observable (e.g., a metric, log, or trace)." .


###  https://ai-square.ch/ai2core#Descriptive
ai2core:Descriptive rdf:type owl:Class ;
                    rdfs:comment "Refers to statistical measures that summarize and quantify the observed behavior of an observable, such as averages, percentiles, minima, and maxima, without inferring causes or predicting future behavior." .


###  https://ai-square.ch/ai2core#Environment
ai2core:Environment rdf:type owl:Class ;
                    rdfs:comment "A configured context—comprising both hardware and software—where a specific version of an application is built, tested, or executed. Also referred to as a stage or phase (e.g., development, testing, staging, production)." .


###  https://ai-square.ch/ai2core#Log
ai2core:Log rdf:type owl:Class ;
            rdfs:subClassOf ai2core:Observable ;
            rdfs:comment "A type of observability data that associates a timestamp with a textual message, typically including a log level (e.g., INFO, ERROR) and optionally an error or status code." .



###  https://ai-square.ch/ai2core#Metric
ai2core:Metric rdf:type owl:Class ;
               rdfs:subClassOf ai2core:Observable ;
               rdfs:comment "A type of observability data (or observable) that associates a timestamp with a numeric value and its unit of measurement (e.g., latency in milliseconds, memory usage in MB)" .


###  https://ai-square.ch/ai2core#TestResult
ai2core:TestResult rdf:type owl:Class ;
              rdfs:subClassOf ai2core:Observable ;
              rdfs:comment "A type of observability data representing Test results (i.e., pass or fail)@en." .


###  https://ai-square.ch/ai2core#TestCase
ai2core:TestCase rdf:type owl:Class ;
              rdfs:subClassOf ai2core:Source ;
              rdfs:comment "A type of source data representing Test case (i.e., or the source where test cases are stored)@en." .

###  https://ai-square.ch/ai2core#TestCaseSpecification
ai2core:TestCaseSpecification rdf:type owl:Class .


###  https://ai-square.ch/ai2core#Model
ai2core:Model rdf:type owl:Class .


###  https://ai-square.ch/ai2core#Observable
ai2core:Observable rdf:type owl:Class ;
                   rdfs:comment "Any type of data that can be collected to monitor and assess the behavior of a system. It provides insight into the system's performance, functionality, or state and helps detect issues or anomalies. Observables include metrics, logs, and traces, which each provide different kinds of data related to the system's operation." .


###  https://ai-square.ch/ai2core#QualityGate
ai2core:QualityGate rdf:type owl:Class .


###  https://ai-square.ch/ai2core#QualityGateExecution
ai2core:QualityGateExecution rdf:type owl:Class ;
                             rdfs:comment "It is a decision checkpoint in the software delivery process that evaluates whether a software artefact meets a predefined set of quality criteria. It aggregates multiple test results and static analysis checks to determine if the software can move to the next stage (e.g., deployment, release)." .


###  https://ai-square.ch/ai2core#Requirement
ai2core:Requirement rdf:type owl:Class ;
                    rdfs:comment "It is a specific measurable condition or capability that a project, environment, quality gate, or observable must satisfy to meet stakeholder needs, fulfil business goals, or comply with standards. Typically defines a pass/fail criterion that must be met, such as performance thresholds, functional correctness, or security constraints." .

###  https://ai-square.ch/ai2core#RequirementSpecification
ai2core:RequirementSpecification rdf:type owl:Class .


###  https://ai-square.ch/ai2core#Capability
ai2core:Capability rdf:type owl:Class ;
                   rdfs:comment "An observable behaviour implied by a requirement, extracted by a language model. A Capability is an inference about what a requirement demands, not a fact recorded in the source tool; its provenance is given by ai2core:detected_by." .


###  https://ai-square.ch/ai2core#CapabilityCoverage
ai2core:CapabilityCoverage rdf:type owl:Class ;
                           rdfs:comment "Reified link between a Capability and the TestCase or Action that exercises it, carrying the per-link confidence and the reason the model gave for the association." .


###  https://ai-square.ch/ai2core#Action
ai2core:Action rdf:type owl:Class ;
               rdfs:comment "A single step of a test case: one thing the tester or the automation does, together with the outcome it expects. Identified by the source_path of the step in the tool it comes from; the step text itself stays in the Resource DB and is reachable through ai2core:remote_url." .

###  https://ai-square.ch/ai2core#Source
ai2core:Source rdf:type owl:Class ;
               rdfs:comment "A software or hardware component that produces observables (e.g., an application, service, database, transaction, server, pod, cluster, server, or sensor)." .

###  https://ai-square.ch/ai2core#SourceSpecification
ai2core:SourceSpecification rdf:type owl:Class .


###  https://ai-square.ch/ai2core#Target
ai2core:Target rdf:type owl:Class ;
               rdfs:subClassOf ai2core:Requirement ;
               rdfs:comment "It is a requirement that involves a metric. It contains an aggregation and reference a group of requirements by an ID." .


###  https://ai-square.ch/ai2core#Trace
ai2core:Trace rdf:type owl:Class ;
              rdfs:subClassOf ai2core:Observable ;
              rdfs:comment "A type of observability data representing distributed traces, capturing the execution flow across sources (i.e., components or services) in a system." .



#################################################################
#    Log Types
#################################################################

###  https://ai-square.ch/ai2log#log.access
<https://ai-square.ch/ai2log#log.access> rdf:type owl:Class ;
                                         rdfs:subClassOf ai2core:Log ;
                                         rdfs:comment "Logs capturing HTTP/API access (e.g., request URI, status codes, IPs)" ;
                                         rdfs:label "log.access" .


###  https://ai-square.ch/ai2log#log.application
<https://ai-square.ch/ai2log#log.application> rdf:type owl:Class ;
                                              rdfs:subClassOf ai2core:Log ;
                                              rdfs:comment "Logs generated by application logic (e.g., info, warning, error messages)"@en ;
                                              rdfs:label "log.application" .


###  https://ai-square.ch/ai2log#log.audit
<https://ai-square.ch/ai2log#log.audit> rdf:type owl:Class ;
                                        rdfs:subClassOf ai2core:Log ;
                                        rdfs:comment "Logs recording user or system actions for traceability and compliance"@en ;
                                        rdfs:label "log.audit" .


###  https://ai-square.ch/ai2log#log.database
<https://ai-square.ch/ai2log#log.database> rdf:type owl:Class ;
                                           rdfs:subClassOf ai2core:Log ;
                                           rdfs:comment "Logs from database systems (e.g., queries, slow logs, connection errors)" ;
                                           rdfs:label "log.database" .


###  https://ai-square.ch/ai2log#log.deployment
<https://ai-square.ch/ai2log#log.deployment> rdf:type owl:Class ;
                                             rdfs:subClassOf ai2core:Log ;
                                             rdfs:comment "Logs from CI/CD pipelines, deployments, or build tools" ;
                                             rdfs:label "log.deployment" .


###  https://ai-square.ch/ai2log#log.infrastructure
<https://ai-square.ch/ai2log#log.infrastructure> rdf:type owl:Class ;
                                                 rdfs:subClassOf ai2core:Log ;
                                                 rdfs:comment "Logs from infrastructure components like Docker, Kubernetes, or proxies" ;
                                                 rdfs:label "log.infrastructure" .


###  https://ai-square.ch/ai2log#log.network
<https://ai-square.ch/ai2log#log.network> rdf:type owl:Class ;
                                          rdfs:subClassOf ai2core:Log ;
                                          rdfs:comment "Logs related to network activity, connections, DNS, or firewalls" ;
                                          rdfs:label "log.network" .


###  https://ai-square.ch/ai2log#log.performance
<https://ai-square.ch/ai2log#log.performance> rdf:type owl:Class ;
                                              rdfs:subClassOf ai2core:Log ;
                                              rdfs:comment "Logs related to performance monitoring or latency events" ;
                                              rdfs:label "log.performance" .


###  https://ai-square.ch/ai2log#log.security
<https://ai-square.ch/ai2log#log.security> rdf:type owl:Class ;
                                           rdfs:subClassOf ai2core:Log ;
                                           rdfs:comment "Logs related to authentication, authorization failures, or threat detection" ;
                                           rdfs:label "log.security" .


###  https://ai-square.ch/ai2log#log.system
<https://ai-square.ch/ai2log#log.system> rdf:type owl:Class ;
                                         rdfs:subClassOf ai2core:Log ;
                                         rdfs:comment "Operating system or runtime logs (e.g., memory, kernel, OS events)" ;
                                         rdfs:label "log.system" .


###  https://ai-square.ch/ai2log#log.test
<https://ai-square.ch/ai2log#log.test> rdf:type owl:Class ;
                                       rdfs:subClassOf ai2core:Log ;
                                       rdfs:comment "Logs produced during automated or manual test execution"@en ;
                                       rdfs:label "log.test" .

###  https://ai-square.ch/ai2log#log.test.error
<https://ai-square.ch/ai2log#log.test.error> rdf:type owl:Class ;
                                       rdfs:subClassOf ai2core:Log ;
                                       rdfs:comment "Error logs produced during automated or manual test execution"@en ;
                                       rdfs:label "log.test.error" .

                            
###  https://ai-square.ch/ai2log#log.test.warning
<https://ai-square.ch/ai2log#log.test.warning> rdf:type owl:Class ;
                                       rdfs:subClassOf ai2core:Log ;
                                       rdfs:comment "Warning logs produced during automated or manual test execution"@en ;
                                       rdfs:label "log.test.warning" .


###  https://ai-square.ch/ai2log#log.test.debug
<https://ai-square.ch/ai2log#log.test.debug> rdf:type owl:Class ;
                                       rdfs:subClassOf ai2core:Log ;
                                       rdfs:comment "Debug logs produced during automated or manual test execution"@en ;
                                       rdfs:label "log.test.debug" .


###  https://ai-square.ch/ai2log#log.test.info
<https://ai-square.ch/ai2log#log.test.info> rdf:type owl:Class ;
                                       rdfs:subClassOf ai2core:Log ;
                                       rdfs:comment "Info logs produced during automated or manual test execution"@en ;
                                       rdfs:label "log.test.info" .



#################################################################
#    Metric Types
#################################################################

###  https://ai-square.ch/ai2apm#metric.http.load
<https://ai-square.ch/ai2apm#metric.http.load> rdf:type owl:Class ;
                                               rdfs:subClassOf ai2core:Metric ;
                                               rdfs:comment "Measures the number of active or ongoing HTTP requests being handled by the application or service at a given moment"@en ;
                                               rdfs:label "metric.http.load" .


###  https://ai-square.ch/ai2apm#metric.http.response_time
<https://ai-square.ch/ai2apm#metric.http.response_time> rdf:type owl:Class ;
                                                        rdfs:subClassOf ai2core:Metric ;
                                                        rdfs:comment "Time taken to respond to an HTTP request"@en ;
                                                        rdfs:label "metric.http.response_time" .


###  https://ai-square.ch/ai2apm#metric.jvm.memory.used
<https://ai-square.ch/ai2apm#metric.jvm.memory.used> rdf:type owl:Class ;
                                                     rdfs:subClassOf ai2core:Metric ;
                                                     rdfs:comment "Amount of memory currently used by the JVM (in bytes)"@en ;
                                                     rdfs:label "metric.jvm.memory.used" .


###  https://ai-square.ch/ai2apm#metric.page.size
<https://ai-square.ch/ai2apm#metric.page.size> rdf:type owl:Class ;
                                               rdfs:subClassOf ai2core:Metric ;
                                               rdfs:comment "Size of the loaded page or response body"@en ;
                                               rdfs:label "metric.page.size" .


###  https://ai-square.ch/ai2apm#metric.performance
<https://ai-square.ch/ai2apm#metric.performance> rdf:type owl:Class ;
                                                 rdfs:subClassOf ai2core:Metric ;
                                                 rdfs:comment "Performance metrics are used to assess the performance relative to the amount of resources used under stated conditions. Sources can include other software, the software and hardware configuration of the system, and materials. The performance metrics are affected strongly and fluctuates depending on the conditions of use, such as load of processing data, frequency of use, number of connecting sites and so on. Therefore, performance efficiency measures might include the ratio of estimated or measured value with error fluctuation to the designed value with allowed error fluctuation range required by specification."@en ;
                                                 rdfs:label "metric.performance"@en .


###  https://ai-square.ch/ai2apm#metric.performance.capacity
<https://ai-square.ch/ai2apm#metric.performance.capacity> rdf:type owl:Class ;
                                                          rdfs:subClassOf <https://ai-square.ch/ai2apm#metric.performance> ;
                                                          rdfs:comment "Capacity metrics are used to assess the degree to which the maximum limits of a product or system parameter meet the requirements"@en ;
                                                          rdfs:label "metric.performance.capacity"@en .


###  https://ai-square.ch/ai2apm#metric.performance.capacity.request
<https://ai-square.ch/ai2apm#metric.performance.capacity.request> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <https://ai-square.ch/ai2apm#metric.performance.capacity> ;
                                                                  rdfs:comment "These metrics correspond to request and capacity. A request can represent a job, a function call, an HTTP request, or a database transaction."@en ;
                                                                  rdfs:label "metric.performance.capacity.request"@en .


###  https://ai-square.ch/ai2apm#metric.performance.capacity.request.fail_rate
<https://ai-square.ch/ai2apm#metric.performance.capacity.request.fail_rate> rdf:type owl:Class ;
                                                                            rdfs:subClassOf <https://ai-square.ch/ai2apm#metric.performance.capacity.request> ;
                                                                            rdfs:comment "The rate of failed requests"@en ;
