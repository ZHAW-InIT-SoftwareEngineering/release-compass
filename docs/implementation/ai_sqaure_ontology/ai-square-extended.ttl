                                                                          rdfs:subClassOf <https://ai-square.ch/ai2apm#metric.performance.tb.request> ;
                                                                          rdfs:comment "Time taken to respond to a request."@en ;
                                                                          rdfs:label "metric.performance.tb.request.response_time"@en .


###  https://ai-square.ch/ai2apm#metric.performance.tb.request.sending_time
