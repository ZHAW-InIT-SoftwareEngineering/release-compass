                                                                  rdfs:label "metric.performance.tb.response.ttfb"@en .


###  https://ai-square.ch/ai2apm#metric.performance.tb.ui
<https://ai-square.ch/ai2apm#metric.performance.tb.ui> rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://ai-square.ch/ai2apm#metric.performance.tb> ;
