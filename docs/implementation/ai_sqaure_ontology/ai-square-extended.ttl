                                                                         rdfs:subClassOf <https://ai-square.ch/ai2apm#metric.performance.tb.request> ;
                                                                         rdfs:comment "Time spent blocked (e.g., waiting for a free TCP connection slot) before initiating the request"@en ;
                                                                         rdfs:label "metric.performance.tb.request.blocked_time"@en .


###  https://ai-square.ch/ai2apm#metric.performance.tb.request.connect_time
